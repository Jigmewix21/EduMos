{
  "expo": {
    "name": "EduMos",
    "slug": "edumos-web2",
    "version": "1.0.1",
    "orientation": "portrait",
    "platforms": [
      "web",
      "ios",
      "android"
    ],
    "splash": {
      "backgroundColor": "#f8fafc",
      "resizeMode": "contain"
    },
    "android": {
      "package": "com.edumos.offlinelearning",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#2563eb"
      }
    },
    "ios": {
      "bundleIdentifier": "com.edumos.offlinelearning"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "extra": {
      "apiBaseUrl": "$EXPO_PUBLIC_API_BASE_URL",
      "eas": {
        "projectId": "f8c2c501-2499-4f54-9886-ed9d0cc8d7f4"
      }
    },
    "owner": "jigmewix21"
  }
}
