{
  "expo": {
    "name": "EduMos",
    "slug": "edumos-web2",
    "version": "1.0.13",
    "orientation": "portrait",
    "icon": "./assets/edumos-icon.png",
    "platforms": [
      "web",
      "ios",
      "android"
    ],
    "splash": {
      "image": "./assets/edumos-splash.png",
      "backgroundColor": "#f8fafc",
      "resizeMode": "contain"
    },
    "android": {
      "package": "com.edumos.offlinelearning",
      "versionCode": 14,
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_STATE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.NEARBY_WIFI_DEVICES"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/edumos-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "ios": {
      "bundleIdentifier": "com.edumos.offlinelearning"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "extra": {
      "apiBaseUrl": "$EXPO_PUBLIC_API_BASE_URL",
      "eas": {
        "projectId": "f8c2c501-2499-4f54-9886-ed9d0cc8d7f4"
      }
    },
    "owner": "jigmewix21"
  }
}
